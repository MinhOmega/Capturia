{
  "name": "capturia",
  "private": true,
  "version": "1.5.4",
  "description": "Free, open-source screen recorder & editor with intelligent cursor tracking, zoom effects, and cinematic output",
  "author": "MinhOmega",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MinhOmega/Capturia.git"
  },
  "homepage": "https://github.com/MinhOmega/Capturia",
  "bugs": {
    "url": "https://github.com/MinhOmega/Capturia/issues"
  },
  "keywords": [
    "screen-recorder",
    "screen-recording",
    "video-editor",
    "electron",
    "cursor-tracking",
    "zoom-effects",
    "macos",
    "open-source",
    "screencast",
    "demo-recording"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build:native": "node scripts/build-native-macos-helper.mjs",
    "build": "npm run build:native && tsc && vite build && electron-builder --publish never",
    "lint": "biome lint .",
    "preview": "vite preview",
    "build:mac": "npm run build:native && tsc && vite build && electron-builder --mac --publish never",
    "build:mac:x64": "npm run build:native && tsc && vite build && electron-builder --mac dmg --x64 --publish never",
    "build:mac:arm64": "npm run build:native && tsc && vite build && electron-builder --mac dmg --arm64 --publish never",
    "build:win": "npm run build:native && tsc && vite build && electron-builder --win --publish never",
    "build:linux": "npm run build:native && tsc && vite build && electron-builder --linux --publish never",
    "build:deb": "npm run build:native && tsc && vite build && electron-builder -c electron-builder.json5 --linux deb -c.linux.target=deb --publish never",
    "build:vite": "vite build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fix-webm-duration/fix": "^1.0.1",
    "@fix-webm-duration/parser": "^1.0.1",
    "@pixi/filter-drop-shadow": "^5.2.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/gif.js": "^0.2.5",
    "@uiw/color-convert": "^2.9.2",
    "@uiw/react-color-block": "^2.9.2",
    "@uiw/react-color-colorful": "^2.9.2",
    "@xenova/transformers": "^2.17.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-timeline": "^2.2.0",
    "emoji-picker-react": "^4.16.1",
    "fix-webm-duration": "^1.0.6",
    "gif.js": "^0.2.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.545.0",
    "mediabunny": "^1.25.1",
    "motion": "^12.23.24",
    "mp4box": "^2.2.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-resizable-panels": "^3.0.6",
    "react-rnd": "^10.5.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "web-demuxer": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "fast-check": "^4.5.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "terser": "^5.44.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.0.16"
  },
  "main": "dist-electron/main.js",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json}": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
